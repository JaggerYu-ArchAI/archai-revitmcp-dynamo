      "Code": "import traceback\r\n\r\ntry:\r\n    # 执行传入的Python代码字符串\r\n    namespace = {}\r\n    exec(IN[0], namespace)\r\n    # 执行成功：直接返回代码中的 OUT 结果\r\n    OUT = namespace.get(\"OUT\", \"执行成功（无返回值）\")\r\n\r\nexcept Exception:\r\n    # 执行失败：直接返回完整报错文本（纯字符串，无包装）\r\n    OUT = \"❌ 代码执行报错：\\n\" + traceback.format_exc()",
