      "Description": "函数输出，请使用自定义节点"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import re\r\n\r\ndef clean_script_string(raw):\r\n    # 去除首尾空白以便检查标记（但不影响最终输出）\r\n    stripped = raw.strip()\r\n    \r\n    # 检查是否包含开头标记（[ 或 ```python）或结尾标记（] 或 ```）\r\n    has_prefix = stripped.startswith('[') or stripped.startswith('```python')\r\n    has_suffix = stripped.endswith(']') or stripped.endswith('```')\r\n    \r\n    if has_prefix or has_suffix:\r\n        # 第一部分：匹配开头的存在包裹标记\r\n        # ^:匹配字符串的开头\r\n        # \\s*:匹配开头的任意数量空白字符（包括换行）\r\n        # (\\[\\s*)?:可选地匹配 [ 及其后面的空白字符\r\n        # ```python：匹配markdown代码块的开头标记\r\n        # \\s*：匹配代码标记块的任意数量空白字符\r\n        # |：或者\r\n        # 第二部分：匹配结尾的包裹标记\r\n        # \\s*:匹配代码块结束标志前的任意数量空白字符\r\n        # ```：匹配markdown代码块的结束标记\r\n        # \\s*：匹配代码标记块结束后的任意数量空白字符\r\n        # (\\[\\s*)?：可选地匹配 ] 及其后面的空白字符\r\n        # $：匹配字符串的结尾\r\n        pattern = r'^\\s*(\\[\\s*)?```python\\s*|\\s*```\\s*(\\]\\s*)?$'\r\n        cleaned = re.sub(pattern, '', raw, flags=re.DOTALL)\r\n        return cleaned.strip()   # 清理后去除首尾空白，得到纯净代码\r\n    else:\r\n        # 没有检测到包裹标记，直接返回原始字符串（保留原格式，包括首尾空白）\r\n        return raw\r\n\r\nraw_str = IN[0]\r\nif raw_str is None or not isinstance(raw_str, str):\r\n    OUT = \"\"   # 输入无效时返回空字符串\r\nelse:\r\n    OUT = clean_script_string(raw_str)",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "2d69c603d7774f96a85fca1ffebcb7ae",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "9fc056f497804f93b8f1b634062b6086",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "f37c5748c4fc4672a444c13c806c5703",
          "Name": "OUT",
          "Description": "Python 脚本结果",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "运行嵌入 Python 脚本。"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import sys\r\nimport os\r\n\r\n# 必须和Packages下的包文件夹名完全一致（大小写敏感）\r\nPACKAGE_NAME = \"ArchAI\"\r\nOUT = \"\"  # 初始化OUT，避免未定义\r\n\r\n# ===================== 1. 自动定位节点包的根路径 =====================\r\n# 获取APPDATA路径\r\nappdata = os.environ.get(\"APPDATA\")\r\n# 定位Dynamo Revit根目录\r\ndynamo_root = os.path.join(appdata, \"Dynamo\", \"Dynamo Revit\")\r\nif not os.path.isdir(dynamo_root):\r\n    print(f\"Dynamo根目录不存在 - {dynamo_root}\")\r\n# 遍历版本目录，查找包路径\r\nlib_path = None\r\ntry:\r\n    for version_dir in os.listdir(dynamo_root):\r\n        version_path = os.path.join(dynamo_root, version_dir)\r\n        # 跳过非目录\r\n        if not os.path.isdir(version_path):\r\n            continue\r\n        temp_lib = os.path.join(version_path, \"Packages\", PACKAGE_NAME)\r\n        # 找到第一个有效路径就停止\r\n        if os.path.exists(temp_lib):\r\n            lib_path = temp_lib\r\n            break\r\nexcept OSError as e:\r\n    print(f\"遍历目录时出错：{str(e)}\")\r\n\r\ndef get_package_lib_path():\r\n    if lib_path not in sys.path:\r\n        sys.path.append(lib_path)\r\n    return lib_path, f\"lib路径：{lib_path}\" if lib_path else \"未找到包的节点包目录\"\r\n\r\n# 初始化路径\r\nget_package_lib_path()\r\n\r\n# ===================== 2. 读取与验证输入（提前做，避免依赖加载后报错） =====================\r\n# 先验证输入，再加载依赖，减少异常\r\napi_key = IN[0].strip() if (len(IN) > 0 and IN[0] and isinstance(IN[0], str)) else \"\"\r\nuser_query = IN[1].strip() if (len(IN) > 1 and IN[1] and isinstance(IN[1], str)) else \"\"\r\n\r\n# 输入验证（失败直接返回，不加载依赖）\r\nif not api_key:\r\n    OUT = \"IN[0] 需要有效的API Key字符串\"\r\nelif not user_query:\r\n    OUT = \"IN[1] 需要有效的问题字符串\"\r\nelse:\r\n    # ===================== 3. 加载路径+导入openai（仅在输入有效时执行） =====================\r\n    # 把元组的第1个元素赋值给lib_path，第2个赋值给path_msg\r\n    lib_path, path_msg = get_package_lib_path()\r\n    print(f\"【路径验证】{path_msg}\")\r\n\r\n    openai_loaded = False\r\n    # 清理缓存，避免加载旧版本\r\n    if \"openai\" in sys.modules.keys():\r\n        del sys.modules[\"openai\"]\r\n    # 核心：把导入逻辑完全放进try里，启动时不会触发\r\n    try:\r\n        # 从 ./extra/lib 中导入openai库；从 ./librevit_mcp_tools 导入配置\r\n        from extra.lib.openai import OpenAI\r\n        from revit_mcp_tools.config import BASE_URL, MODEL\r\n        \r\n        print(\"openai导入成功\")\r\n        openai_loaded = True\r\n    except Exception as e:\r\n        OUT = f\"openai导入失败：{type(e).__name__} - {str(e)}\"\r\n        print(OUT)\r\n\r\n    # ===================== 4. 调用 DeepSeek API（仅在依赖加载成功时执行） =====================\r\n    if openai_loaded:\r\n        system_message = f\"\"\"\r\n你是专业的Revit Dynamo PythonScript代码生成助手，仅输出可运行的纯代码，不包含任何解释、说明文字或额外文本。绝对遵循以下规则：\r\n【规则1】：禁止使用Pyrevit代码、ironpython、Revit MCP代码，严格使用原生Revit API，版本为Revit 2024。\r\n【规则2】：所有尺寸参数必须通过Revit API的UnitUtils.ConvertToInternalUnits方法将米（m）、毫米(mm)、厘米(cm)转换为英尺。\r\n【规则3】：为避免错误，必须使用以下的固定导入内容（自行去掉退格缩进），禁止自行导入其他内容：\r\n        import sys\r\n        import os\r\n        import math\r\n        import json\r\n        import clr\r\n        \r\n        import clr\r\n        clr.AddReference('ProtoGeometry')\r\n        from Autodesk.DesignScript.Geometry import *\r\n        clr.AddReference('DSCoreNodes')\r\n        import DSCore  # 为避免冲突，使用DSCore.List.XX\r\n        clr.AddReference('RevitNodes')\r\n        import Revit   # 为避免冲突，使用Revit.Elements.XX\r\n        clr.ImportExtensions(Revit.Elements)\r\n        clr.ImportExtensions(Revit.GeometryConversion)\r\n        \r\n        clr.AddReference('RevitAPI')\r\n        clr.AddReference('RevitAPIUI')\r\n        from Autodesk.Revit.DB import *\r\n        from Autodesk.Revit.UI import *\r\n        from System.Collections.Generic import *\r\n        \r\n        clr.AddReference(\"RevitServices\")\r\n        import RevitServices\r\n        from RevitServices.Persistence import DocumentManager\r\n        from RevitServices.Transactions import TransactionManager\r\n        \r\n        doc = DocumentManager.Instance.CurrentDBDocument\r\n        app = doc.Application\r\n        uiApp = DocumentManager.Instance.CurrentUIApplication\r\n        uidoc = uiApp.ActiveUIDocument\r\n\r\n【规则4】：为避免错误，必须使用以下固定格式（自行去掉退格缩进），禁止自行修改：\r\n        固定导入内容\r\n        TransactionManager.Instance.EnsureInTransaction(doc)\r\n        你的代码\r\n        TransactionManager.Instance.TransactionTaskDone()\r\n【规则5】：参数不全时，使用OUT输出，直接向用户索要必填参数，不说多余的话。\r\n【规则6】：非Revit代码生成需求，直接拒绝。\r\n\"\"\"\r\n        try:\r\n            client = OpenAI(api_key=api_key, base_url= BASE_URL)\r\n            response = client.chat.completions.create(\r\n                model= MODEL,\r\n                messages=[{\"role\":\"system\",\"content\":system_message},{\"role\":\"user\",\"content\":user_query}],\r\n                stream=False\r\n            )\r\n            OUT = response.choices[0].message.content\r\n        except Exception as e:\r\n            OUT = f\"API 调用失败：{str(e)}\"\r\n            print(OUT)\r\n    elif not openai_loaded and not OUT:\r\n        OUT = \"未加载到openai模块，无法调用API\"\r\n        print(OUT)\r\n\r\n# 最终输出（确保OUT始终有值）\r\nprint(f\"最终结果：{OUT}\")",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "2b5ebf3971c942f597df93b29ea47902",
      "NodeType": "PythonScriptNode",
