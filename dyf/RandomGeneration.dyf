    {
      "ConcreteType": "Dynamo.Graph.Nodes.CustomNodes.Output, DynamoCore",
      "ElementResolver": null,
      "Symbol": "// AI-Generated Result\r\n// 返回 AI 生成的结果\r\nResult",
      "Id": "10acd158a087404d9f2345fd240ced34",
      "NodeType": "OutputNode",
      "Inputs": [
        {
          "Id": "f11005afa9914a17996f29fbcc8e6a51",
          "Name": "",
          "Description": "输出数据",
          "UsingDefaultValue": false,
