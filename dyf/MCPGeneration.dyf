{
  "Uuid": "0b98269e-1325-4569-a0f9-fbd77cb4dac8",
  "IsCustomNode": true,
  "Category": "ArchAI.Modeling",
  "Description": "Powered by AI & MCP, invoke usable revit execution tools | AI + MCP驱动，调用可用的 Revit 执行工具",
  "Name": "MCPGeneration",
  "ElementResolver": {
    "ResolutionMap": {}
  },
