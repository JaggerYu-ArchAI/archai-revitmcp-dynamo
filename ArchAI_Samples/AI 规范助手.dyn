      "InputValue": "C:\\Users\\14020\\AppData\\Roaming\\Dynamo\\Dynamo Revit\\2.19\\packages\\ArchAI\\specification\\assets\\spec_files\\核电厂防火设计规范_GBT22158-2021.md"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "c44057a241b8452cbe38ce30b026e754",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "5da78adbd1e947d9b17a077576e2ee31",
